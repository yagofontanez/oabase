# URL pública do site — entra em canonical, sitemap, robots e Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — o que o app precisa
#
# Sem estas duas, o app cai para os dados de exemplo de
# src/lib/content/data.ts e continua rodando (útil para mexer no design).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Token opcional da sessão do próprio aluno para as ferramentas pessoais do MCP.
# Nunca use service role aqui; a RLS continua sendo a fronteira de acesso.
# OABASE_ACCESS_TOKEN=

# Endpoint MCP remoto. Por padrão o servidor HTTP escuta somente em loopback.
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8787
# MCP_PUBLIC_URL=https://oabase.com.br/api/mcp
# MCP_ALLOWED_HOSTS=oabase.com.br
# MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai
# MCP_RATE_LIMIT=60
# MCP_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# Supabase — o que só as ferramentas precisam
#
# Nada abaixo pertence ao runtime do app. A chave anônima acima já é
# suficiente porque o RLS é quem separa o conteúdo aberto do pago.
# ---------------------------------------------------------------------------

# Usada pelo psql e pelo pipeline de ingestão. Contém a senha do banco.
# SUPABASE_CONNECTION_STRING=postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres

# Token pessoal do CLI (supabase link / db push). Dá acesso a TODOS os seus
# projetos, não só a este — o lugar natural dele é o config do CLI
# (`supabase login`), não o .env de uma aplicação.
# SUPABASE_ACCESS_TOKEN=sbp_...

# Ignora RLS por completo. Nunca no app: só no pipeline de ingestão.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# IA — plano de estudos
#
# Sem prefixo público de propósito: a chave só é lida no servidor, em
# src/lib/ia/plano.ts, e nunca chega ao navegador.
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_...

# Opcional. Padrão: openai/gpt-oss-120b.
# GROQ_MODEL=

# ---------------------------------------------------------------------------
# Pagamento — Asaas
#
# Sandbox é o padrão. Só vira produção com ASAAS_AMBIENTE=producao escrito
# de forma explícita: o pior defeito possível aqui é cobrar dinheiro real
# por engano.
#
# ATENÇÃO: as chaves começam com "$aact_" e o dotenv do Next expande $VAR.
# Entre aspas simples ou duplas sem escape o valor chega VAZIO, sem erro
# nenhum. A única forma que funciona é ASAAS_API_KEY="\$aact_...".
# ---------------------------------------------------------------------------
# ASAAS_AMBIENTE=producao
# ASAAS_API_KEY_SANDBOX="\$aact_..."
# ASAAS_API_KEY="\$aact_..."

# Token que a Asaas envia no cabeçalho `asaas-access-token`. Cadastre o mesmo
# valor no painel dela ao criar o webhook. Vazio = a conferência é pulada
# (aceitável em sandbox, nunca em produção).
# ASAAS_WEBHOOK_TOKEN=

# Segredo que autoriza /api/asaas/webhook a chamar confirmar_pagamento e
# cancelar_pagamento no banco. É gerado pelo próprio Postgres na migration
# 20260901120000 e vive em `interno.segredos` — esquema sem permissão para
# papel nenhum, e por isso nunca esteve numa migration versionada. Recupere
# com:
#   psql "$SUPABASE_CONNECTION_STRING" -tAc \
#     "select valor from interno.segredos where chave='webhook_asaas';"
# ASAAS_WEBHOOK_SEGREDO=

# ---------------------------------------------------------------------------
# Embeddings — questões parecidas
#
# Opcional. Sem estas, `questoes_parecidas` continua funcionando por
# dispositivo em comum (questao_artigos) e semelhança de texto em português;
# com elas, o pipeline preenche `questoes.embedding` e a função passa a usar
# distância de cosseno também.
#
# O protocolo é o `POST /embeddings` da OpenAI — o mesmo da Vercel AI Gateway
# e do Azure OpenAI. O modelo PRECISA devolver 1536 dimensões: é o tamanho
# declarado em `vector(1536)`, e o pipeline recusa antes de gravar qualquer
# coisa se não bater.
#
#   cd ingest && python3 -m oabase_ingest.embeddings
# ---------------------------------------------------------------------------
# EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODELO=text-embedding-3-small

# ---------------------------------------------------------------------------
# E-mail — Resend
#
# Três mensagens: confirmação de compra (disparada pelo webhook da Asaas),
# lembrete diário de revisão e aviso de fim de plano (disparados pelo cron em
# /api/tarefas/emails).
#
# O remetente PRECISA ser de um domínio verificado no Resend, senão a API
# recusa com 403. Enquanto oabase.com.br não verifica, use
# "OABase <onboarding@resend.dev>" — que só entrega para o e-mail dono da
# conta do Resend.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# EMAIL_REMETENTE="OABase <ola@oabase.com.br>"
# EMAIL_RESPOSTA=suporte@oabase.com.br

# Autoriza quem chama /api/tarefas/emails. Na Vercel, o Cron envia esta
# variável em `Authorization: Bearer ...` automaticamente quando ela se chama
# CRON_SECRET.
# CRON_SECRET=

# Segredo que autoriza a rota do cron a chamar destinatarios_revisao,
# destinatarios_plano_acabando e registrar_email. Gerado pelo Postgres na
# migration 20260901240000 e guardado em `interno.segredos` — separado do
# segredo do webhook de propósito: quem consegue disparar e-mail não deveria,
# pelo mesmo vazamento, conseguir confirmar pagamento. Recupere com:
#   psql "$SUPABASE_CONNECTION_STRING" -tAc \
#     "select valor from interno.segredos where chave='cron_email';"
# CRON_EMAIL_SEGREDO=
