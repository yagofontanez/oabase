{
 "uid": "oabase",
 "title": "OABase — produção",
 "tags": [
  "oabase"
 ],
 "timezone": "America/Sao_Paulo",
 "refresh": "5s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "5s",
   "10s",
   "30s",
   "1m",
   "5m"
  ]
 },
 "schemaVersion": 39,
 "version": 2,
 "editable": false,
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Site — o que as pessoas estão vendo",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Requisições por segundo",
   "description": "Tudo que chega ao Caddy: páginas, API, arquivos.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(caddy_http_requests_total[1m]))",
     "legendFormat": "",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "fixed"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Erros do servidor (5xx)",
   "description": "Parte das respostas que foram erro do servidor nos últimos 5 minutos.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (sum(rate(caddy_http_request_duration_seconds_count{code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(caddy_http_request_duration_seconds_count[5m])), 1e-9)",
     "legendFormat": "",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Tempo de resposta (p95)",
   "description": "95% das respostas saem mais rápido que isto.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "",
     "refId": "A",
     "range": true,
     "instant": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 1.5
       }
      ]
     },
     "decimals": 3
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "App no ar",
   "description": "1 = o container do app foi visto no último minuto.",
   "datasource": {
    "type": "prometheus",
