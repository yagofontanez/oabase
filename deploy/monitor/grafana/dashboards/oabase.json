  {
   "id": 8,
   "type": "timeseries",
   "title": "Requisições por segundo, por tipo de resposta",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(caddy_http_request_duration_seconds_count{code=~\"2..\"}[1m]))) or vector(0)",
     "legendFormat": "2xx — ok",
     "refId": "A",
     "range": true,
     "instant": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(caddy_http_request_duration_seconds_count{code=~\"3..\"}[1m]))) or vector(0)",
     "legendFormat": "3xx — redirecionamento",
     "refId": "B",
     "range": true,
     "instant": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(caddy_http_request_duration_seconds_count{code=~\"4..\"}[1m]))) or vector(0)",
     "legendFormat": "4xx — não encontrado / sem permissão",
     "refId": "C",
     "range": true,
     "instant": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(caddy_http_request_duration_seconds_count{code=~\"5..\"}[1m]))) or vector(0)",
     "legendFormat": "5xx — erro do servidor",
     "refId": "D",
     "range": true,
     "instant": false
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "gradientMode": "opacity",
      "showPoints": "never",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   }
  },
